name: Build Android APK

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Unzip Project Files
        run: |
          echo "Unzipping project..."
          unzip -o inshae-ttbyq.zip
          
          # نقل الملفات تلقائياً إذا استخرجت داخل مجلد فرعي
          SUBFOLDERS=$(find . -maxdepth 1 -mindepth 1 -type d ! -name ".*")
          if [ $(echo "$SUBFOLDERS" | wc -l) -eq 1 ] && [ -n "$SUBFOLDERS" ]; then
            echo "Moving files from subfolder: $SUBFOLDERS"
            mv $SUBFOLDERS/* . 2>/dev/null || true
            mv $SUBFOLDERS/.* . 2>/dev/null || true
          fi

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Dependencies
        run: |
          if [ -f "package.json" ]; then
            echo "package.json found. Running npm install..."
            npm install --legacy-peer-deps || npm install --force
          else
            echo "No package.json found. Skipping npm install."
          fi

      - name: Build Web Assets & Sync Capacitor
        run: |
          if [ -f "package.json" ]; then
            npm run build --if-present || true
            npx cap sync android || true
          fi

      - name: Build Android APK
        run: |
          GRADLEW_PATH=$(find . -name "gradlew" | head -n 1)
          if [ -n "$GRADLEW_PATH" ]; then
            echo "Found gradlew at $GRADLEW_PATH"
            GRADLE_DIR=$(dirname "$GRADLEW_PATH")
            cd "$GRADLE_DIR"
            chmod +x gradlew
            ./gradlew assembleDebug
          else
            echo "Error: gradlew file not found in the project!"
            exit 1
          fi

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-debug-apk
          path: '**/build/outputs/apk/debug/*.apk'
